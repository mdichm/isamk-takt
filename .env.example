# =============================================================================
# TAKT — Variables d'environnement (exemple)
# Copiez ce fichier vers .env et adaptez les valeurs.
# =============================================================================

# Serveur
PORT=3000
NODE_ENV=development

# OpenAPI / Swagger UI
# Définissez OPENAPI_ENABLED=false pour désactiver la documentation API
# En production (NODE_ENV=production), /api/docs est automatiquement désactivé
OPENAPI_ENABLED=true
OPENAPI_PATH=api/docs

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/takt?schema=public

# OpenTelemetry
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4317
