{
  "name": "takt",
  "version": "0.0.0",
  "private": true,
  "description": "TAKT - Monorepo for ISAMK scheduling application",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "pnpm lint && pnpm typecheck && pnpm build",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "turbo": "^2.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "undici": "^8.12.1",
      "tmp": "^0.2.7",
      "mysql2": "^3.24.0",
      "deepmerge-ts": "^8.0.0",
      "braces": "^3.0.3",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1"
    }
  },
  "dependencies": {
    "helmet": "^8.3.0"
  }
}
