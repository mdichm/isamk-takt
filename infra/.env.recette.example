# SPDX-License-Identifier: AGPL-3.0-only
# TAKT - Environment Variables: Recette
# Copy to .env and adjust values as needed
# NEVER commit .env files with real secrets!

# ============================================================================
# Registry & Images
# ============================================================================
REGISTRY=ghcr.io
REPOSITORY_OWNER=mdichm
IMAGE_TAG=latest
PROJECT_NAME=takt

# ============================================================================
# PostgreSQL
# ============================================================================
POSTGRES_USER=takt_recette
POSTGRES_PASSWORD=takt_recette_password
POSTGRES_DB=takt_recette

# ============================================================================
# API (NestJS) - Secrets montés en fichiers (lecture seule, absentes des images)
# ============================================================================
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret
# Valeurs par défaut uniquement pour le développement local (à ne PAS utiliser en production)
JWT_SECRET=change_me_in_recette_min_32_chars
JWT_REFRESH_SECRET=change_me_in_recette_min_32_chars

# ============================================================================
# SMTP (API egress only - via smtp network)
# ============================================================================
SMTP_HOST=cck.rnu.tn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER_FILE=/run/secrets/smtp_user
SMTP_PASS_FILE=/run/secrets/smtp_pass
SMTP_USER=
SMTP_PASS=
# Adresse expéditrice : fournie par le secret /run/secrets/smtp_from
SMTP_FROM=
SMTP_FROM_NAME=TAKT Recette
APP_URL=https://recette.takt.local

# ============================================================================
# TLS Certificates (Nginx)
# ============================================================================
# In production: mount Let's Encrypt or internal CA certs to ./certs/
# In dev: self-signed certs are generated by nginx.Dockerfile
# NGINX_CERT_PATH=./certs/takt.crt
# NGINX_KEY_PATH=./certs/takt.key

# ============================================================================
# pgAdmin (optional)
# ============================================================================
PGADMIN_EMAIL=admin@takt.recette.local
PGADMIN_PASSWORD=admin

# ============================================================================
# Notes
# ============================================================================
# - In recette, use strong random secrets (openssl rand -base64 32)
# - Secrets should be mounted as files, not passed as env vars
# - See docs/ST_TAKT.md §1.8, §5.3 for security requirements
# - Only port 443 (nginx) should be exposed externally
# - API, Worker, DB are on internal networks only
# - Worker has NO egress; API only has SMTP egress via smtp network