# SPDX-License-Identifier: AGPL-3.0-only
# TAKT - Environment Variables: Production
# Copy to .env and adjust values as needed
# NEVER commit .env files with real secrets!

# ============================================================================
# Registry & Images
# ============================================================================
REGISTRY=ghcr.io
REPOSITORY_OWNER=mdichm
IMAGE_TAG=latest
PROJECT_NAME=takt

# ============================================================================
# PostgreSQL
# ============================================================================
POSTGRES_USER=takt_prod
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_DB=takt_prod

# ============================================================================
# API (NestJS) - Secrets montés en fichiers (lecture seule, absentes des images)
# ============================================================================
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret
# NE PAS mettre de valeurs par défaut en production - les secrets doivent être montés en fichiers
JWT_SECRET=
JWT_REFRESH_SECRET=

# ============================================================================
# SMTP (API egress only - via smtp network)
# ============================================================================
SMTP_HOST=cck.rnu.tn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER_FILE=/run/secrets/smtp_user
SMTP_PASS_FILE=/run/secrets/smtp_pass
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@takt.prod.local

# ============================================================================
# TLS Certificates (Nginx)
# ============================================================================
# In production: mount Let's Encrypt or internal CA certs to ./certs/
# NGINX_CERT_PATH=./certs/takt.crt
# NGINX_KEY_PATH=./certs/takt.key

# ============================================================================
# pgAdmin (optional - disabled in production by default)
# ============================================================================
PGADMIN_EMAIL=admin@takt.prod.local
PGADMIN_PASSWORD=admin

# ============================================================================
# Notes
# ============================================================================
# - En production, utiliser des secrets forts (openssl rand -base64 32)
# - Les secrets doivent être montés en fichiers (Docker secrets / volumes), jamais en variables d'environnement
# - Voir docs/ST_TAKT.md §1.8, §5.3 pour les exigences de sécurité
# - Seul le port 443 (nginx) doit être exposé externement
# - API, Worker, DB sont sur des réseaux internes uniquement
# - Worker n'a aucune route sortante ; l'API n'a que la route SMTP via le réseau smtp