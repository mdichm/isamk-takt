# SPDX-License-Identifier: AGPL-3.0-only
# TAKT - Development Environment Variables
# Copy to .env and adjust values as needed
# NEVER commit .env files with real secrets!

# ============================================================================
# PostgreSQL
# ============================================================================
POSTGRES_USER=takt
POSTGRES_PASSWORD=takt_dev_password
POSTGRES_DB=takt_dev

# ============================================================================
# API (NestJS)
# ============================================================================
# Secrets montee en fichiers (lecture seule, absentes des images Docker).
# En production, utiliser des fichiers montes (Docker secrets / volumes) et
# indiquer ici le chemin du fichier contenant la valeur.
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_REFRESH_SECRET_FILE=/run/secrets/jwt_refresh_secret
# Valeurs par défaut uniquement pour le developpement local (a ne PAS utiliser en production)
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_min_32_chars

# ============================================================================
# SMTP (API egress only - via smtp network)
# ============================================================================
SMTP_HOST=cck.rnu.tn
SMTP_PORT=587
SMTP_SECURE=false
# Identifiants SMTP montee en fichiers (lecture seule, absentes des images)
SMTP_USER_FILE=/run/secrets/smtp_user
SMTP_PASS_FILE=/run/secrets/smtp_pass
SMTP_USER=
SMTP_PASS=
# Adresse d'expedition SMTP : utilisez SMTP_FROM_FILE (/run/secrets/smtp_from) en production/recette
SMTP_FROM=
SMTP_FROM_FILE=
SMTP_FROM_NAME=TAKT
APP_URL=http://localhost:3000

# ============================================================================
# TLS Certificates (Nginx)
# ============================================================================
# In production: mount Let's Encrypt or internal CA certs to ./certs/
# In dev: self-signed certs are generated by nginx.Dockerfile
# NGINX_CERT_PATH=./certs/takt.crt
# NGINX_KEY_PATH=./certs/takt.key

# ============================================================================
# pgAdmin (optional)
# ============================================================================
PGADMIN_EMAIL=admin@takt.local
PGADMIN_PASSWORD=admin

# ============================================================================
# Observabilité (Prometheus, Grafana, Loki, Tempo)
# ============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# OpenTelemetry traces endpoint (defaut: Tempo sur le reseau observability)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4317

# ============================================================================
# Notes
# ============================================================================
# - In production, use strong random secrets (openssl rand -base64 32)
# - Secrets should be mounted as files, not passed as env vars
# - See docs/ST_TAKT.md §1.8, §5.3 for security requirements
# - Only port 443 (nginx) should be exposed externally
# - API, Worker, DB are on internal networks only
# - Worker has NO egress; API only has SMTP egress via smtp network
