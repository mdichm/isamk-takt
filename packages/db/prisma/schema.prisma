generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum RoleCode {
  ADMINISTRATEUR
  GESTIONNAIRE
  RESPONSABLE_DEPARTEMENT
  ENSEIGNANT
  DIRECTION
  ETUDIANT
}

// Fournisseur d'authentification — L0-14 Interface AuthProvider
// Permet d'authentifier via le fournisseur LOCAL (mot de passe hashé) ou un
// fournisseur externe futur (OIDC, LDAP/AD) sans impacter le RBAC.
enum AuthProvider {
  LOCAL
  OIDC
  LDAP
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  MOVED
}

// Statut d'une année universitaire — L1-02
enum AnneeStatut {
  PREPARATION
  ACTIVE
  CLOTUREE
}

// Type de groupe hiérarchique — L1-04
enum GroupeType {
  SECTION
  GROUPE
  SOUS_GROUPE
}

// Niveau d'exigence d'équipement — L1-11
enum ExigenceNiveau {
  OBLIGATOIRE
  SOUHAITE
}

// Jour de la semaine pour la grille horaire — L1-17
enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
}

// ============================================
// MODELS
// ============================================

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  email              String       @unique
  // Optionnel : un compte authentifié via un fournisseur externe (OIDC/LDAP)
  // n'a pas de mot de passe local.
  passwordHash       String?
  firstName          String       @map("nom")
  lastName           String       @map("prenom")
  isActive           Boolean      @default(true) @map("actif")
  desactiveLe        DateTime?
  failedAttempts     Int          @default(0)
  lockedUntil        DateTime?
  mfaSecret          String?
  mfaActive          Boolean      @default(false)
  mustChangePassword Boolean      @default(false)
  passwordChangedAt  DateTime     @default(now())
  lastLoginAt        DateTime?
  // Fournisseur d'authentification (LOCAL par défaut, OIDC/LDAP pour le SSO futur) — L0-14
  provider           AuthProvider @default(LOCAL)
  // Identifiant sujet du fournisseur externe (ex. sub OIDC), unique par fournisseur — L0-14
  providerSubject    String?      @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  roles           UserSystemRole[]
  assignedTasks   Task[]               @relation("AssignedTasks")
  createdTasks    Task[]               @relation("CreatedTasks")
  comments        Comment[]
  activities      Activity[]
  projectMembers  ProjectMember[]
  sprintMembers   SprintMember[]
  refreshTokens   RefreshToken[]
  passwordHistory PasswordHistory[]
  resetTokens     PasswordResetToken[]

  @@index([email])
  @@index([isActive])
  @@map("users")
}

model UserSystemRole {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  role            RoleCode
  departementCode String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, departementCode])
  @@map("user_roles")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  familyId       String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastActivityAt DateTime  @default(now())
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  demandePar String    @db.Uuid
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  key         String        @unique
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members ProjectMember[]
  tasks   Task[]
  sprints Sprint[]
  columns BoardColumn[]

  @@index([key])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  role      UserRole @default(VIEWER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model BoardColumn {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  position  Int
  color     String   @default("#6366f1")
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([position])
  @@map("board_columns")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  columnId    String?      @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  storyPoints Int?
  position    Int          @default(0)
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column       BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId   String?      @db.Uuid
  creator      User         @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId    String       @db.Uuid
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintId     String?      @db.Uuid
  parentTask   Task?        @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  parentTaskId String?      @db.Uuid
  subtasks     Task[]       @relation("Subtasks")
  comments     Comment[]
  activities   Activity[]
  tags         TaskTag[]

  @@index([projectId])
  @@index([columnId])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([status])
  @@index([parentTaskId])
  @@map("tasks")
}

model Sprint {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  name      String
  goal      String?
  status    SprintStatus @default(PLANNING)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  members SprintMember[]

  @@index([projectId])
  @@index([status])
  @@map("sprints")
}

model SprintMember {
  id       String @id @default(uuid()) @db.Uuid
  sprintId String @db.Uuid
  userId   String @db.Uuid

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sprintId, userId])
  @@index([sprintId])
  @@index([userId])
  @@map("sprint_members")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @db.Uuid
  tagId  String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  taskId    String?      @db.Uuid
  userId    String       @db.Uuid
  type      ActivityType
  field     String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime     @default(now())

  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

// Paramètres de sécurité (ligne unique, CHECK id = 1) — EX-SEC-04
model ParametreSecurite {
  id                        Int        @id @default(1)
  longueurMin               Int        @default(12)
  regles                    Json       @default("{}")
  expirationJours           Int        @default(0)
  historique                Int        @default(5)
  maxEchecs                 Int        @default(5)
  verrouillageMinutes       Int        @default(15)
  inactiviteMinutes         Int        @default(30)
  mfaRoles                  RoleCode[] @default([ADMINISTRATEUR])
  conservationAuditJours    Int?
  conservationSecuriteJours Int        @default(365)
  updatedAt                 DateTime   @updatedAt
  updatedBy                 String?    @db.Uuid

  @@map("parametres_securite")
}

// Circuit de validation et de publication (ligne unique, CHECK id = 1) — EX-WFL-02
model ParametreWorkflow {
  id                        Int      @id @default(1)
  validationPlanningRequise Boolean  @default(true)
  publicationRequise        Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?  @db.Uuid

  @@map("parametres_workflow")
}

// Journal de sécurité, séparé de l'audit métier — EX-SEC-09
model SecurityEvent {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  type      String
  userId    String?  @db.Uuid
  email     String?
  ip        String?
  userAgent String?
  requestId String?
  details   Json?

  @@index([type, at])
  @@index([userId, at])
  @@map("security_events")
}

// Audit append-only — EX-AUD-01
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  at             DateTime @default(now())
  userId         String?  @db.Uuid
  action         String
  objetType      String
  objetId        String
  ancienneValeur Json?
  nouvelleValeur Json?
  versionId      String?  @db.Uuid
  motif          String?
  requestId      String?
  ip             String?

  @@index([objetType, objetId])
  @@index([versionId, at])
  @@index([userId, at])
  @@map("audit_logs")
}

// ============================================
// Calendrier scolaire (L1-01 : années & semestres)
// ============================================

model Annee {
  id         String      @id @default(uuid()) @db.Uuid
  numero     Int // ex: 2026
  code       String // ex: "2026-2027"
  nbSemaines Int         @default(14)
  statut     AnneeStatut @default(PREPARATION)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  semestres    Semestre[]
  departements Departement[]
  enseignants  Enseignant[]

  @@unique([code])
  @@unique([numero])
  @@map("annees")
}

model Semestre {
  id         String   @id @default(uuid()) @db.Uuid
  numero     Int // 1 ou 2
  anneeId    String   @db.Uuid
  annee      Annee    @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  nbSemaines Int      @default(14)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  groupes    Groupe[]
  decharges  Decharge[]
  creneaux   Creneau[]

  @@unique([anneeId, numero])
  @@map("semestres")
}

// ============================================
// Grille horaire (L1-17 : créneaux et pauses)
// ============================================

model Creneau {
  id        String      @id @default(uuid()) @db.Uuid
  semestreId String     @db.Uuid
  semestre   Semestre   @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  jour       JourSemaine
  ordre      Int        // position dans la journée (1..n)
  heureDebut DateTime   @db.Time
  heureFin   DateTime   @db.Time
  estPause   Boolean    @default(false)
  estActive  Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([semestreId, jour, ordre])
  @@index([semestreId, jour])
  @@map("creneaux")
}

// ============================================
// Structure académique (L1-03 : départements, formations, niveaux)
// ============================================

model Departement {
  id        String   @id @default(uuid()) @db.Uuid
  anneeId   String   @db.Uuid
  annee     Annee    @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  code      String // ex: "INFO", "MATH"
  libelle   String // ex: "Informatique", "Mathématiques"
  ordre     Int      @default(0)
  originId  String? // ID d'origine externe (synchronisation)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formations  Formation[]
  enseignants Enseignant[]
  salles      Salle[]

  @@unique([anneeId, code])
  @@index([anneeId, ordre])
  @@map("departements")
}

model Formation {
  id            String      @id @default(uuid()) @db.Uuid
  departementId String      @db.Uuid
  departement   Departement @relation(fields: [departementId], references: [id], onDelete: Cascade)
  code          String // ex: "L3-INFO"
  libelle       String // ex: "Licence 3 Informatique"
  ordre         Int         @default(0)
  originId      String? // ID d'origine externe (synchronisation)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  niveaux Niveau[]

  @@unique([departementId, code])
  @@index([departementId, ordre])
  @@map("formations")
}

model Niveau {
  id          String    @id @default(uuid()) @db.Uuid
  formationId String    @db.Uuid
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  code        String // ex: "L3"
  libelle     String // ex: "Licence 3"
  ordre       Int       @default(0)
  originId    String? // ID d'origine externe (synchronisation)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  groupes Groupe[]
  modules Module[]

  @@unique([formationId, code])
  @@index([formationId, ordre])
  @@map("niveaux")
}

// ============================================
// Groupes hiérarchiques (L1-04)
// ============================================

model Groupe {
  id         String     @id @default(uuid()) @db.Uuid
  niveauId   String     @db.Uuid
  niveau     Niveau     @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  semestreId String     @db.Uuid
  semestre   Semestre   @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  parentId   String?    @db.Uuid
  parent     Groupe?    @relation("GroupesHierarchie", fields: [parentId], references: [id])
  enfants    Groupe[]   @relation("GroupesHierarchie")
  type       GroupeType
  code       String // ex: "INFO-L3-S1"
  libelle    String // ex: "L3 Informatique Semestre 1"
  ordre      Int        @default(0)
  effectif   Int        @default(0)
  originId   String? // ID d'origine externe (synchronisation)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([niveauId, semestreId, code])
  @@index([niveauId, semestreId, ordre])
  @@index([semestreId])
  @@index([parentId])
  @@map("groupes")
}

// ============================================
// Modules, types d'enseignement et grades (L1-05)
// ============================================

enum TypeEnseignementCode {
  CM
  TD
  TP
  CI
  AUTRE
}

model TypeEnseignement {
  id            String               @id @default(uuid()) @db.Uuid
  code          TypeEnseignementCode
  libelle       String
  activityTagId String?              @db.Uuid
  activityTag   ActivityTag?         @relation(fields: [activityTagId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  modules Module[]
  exigencesEquipement ExigenceEquipement[] @relation("TypeExigenceEquipement")

  @@unique([code])
  @@map("types_enseignement")
}

enum GradeCode {
  MC
  MCF
  PR
  ATER
  AUTRE
}

model Grade {
  id        String    @id @default(uuid()) @db.Uuid
  code      GradeCode
  libelle   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  modules     Module[]
  enseignants Enseignant[]

  @@unique([code])
  @@map("grades")
}

model Module {
  id                String             @id @default(uuid()) @db.Uuid
  niveauId          String             @db.Uuid
  niveau            Niveau             @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  typeId            String             @db.Uuid
  type              TypeEnseignement   @relation(fields: [typeId], references: [id], onDelete: Cascade)
  gradeId           String?            @db.Uuid
  grade             Grade?             @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  code              String // ex: "INFO301"
  libelle           String // ex: "Algorithmique avancée"
  semestreNumero    Int // 1 ou 2
  credits           Int?               @default(6)
  effectifMax       Int? // capacité max du module
  originId          String? // ID d'origine externe (synchronisation)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  enseignantModules EnseignantModule[]
  exigencesEquipement ExigenceEquipement[] @relation("ModuleExigenceEquipement")

  @@unique([niveauId, code, semestreNumero])
  @@index([niveauId])
  @@index([typeId])
  @@index([gradeId])
  @@map("modules")
}

// ============================================
// Activity Tags (L1-06)
// ============================================

model ActivityTag {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  libelle   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  typesEnseignement TypeEnseignement[]
  salleActivityTags SalleActivityTag[] @relation("ActivityTagSalleActivityTag")

  @@index([code])
  @@index([isActive])
  @@map("activity_tags")
}

model Enseignant {
  id                String             @id @default(uuid()) @db.Uuid
  matricule         String
  nom               String
  prenom            String
  email             String             @unique
  telephone         String?
  isActive          Boolean            @default(true)
  anneeId           String             @db.Uuid
  annee             Annee              @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  departementId     String             @db.Uuid
  departement       Departement        @relation(fields: [departementId], references: [id], onDelete: Cascade)
  gradeId           String?            @db.Uuid
  grade             Grade?             @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  enseignantModules EnseignantModule[]
  decharges         Decharge[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([anneeId, matricule])
  @@index([departementId])
  @@index([gradeId])
  @@index([email])
  @@map("enseignants")
}

model EnseignantModule {
  enseignantId String     @db.Uuid
  moduleId     String     @db.Uuid
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([enseignantId, moduleId])
  @@map("enseignant_modules")
}

// ============================================
// Décharges enseignant (L1-08)
// ============================================

model Decharge {
  id          String   @id @default(uuid()) @db.Uuid
  heures      Float    // heures équivalentes de décharge
  enseignantId String  @db.Uuid
  enseignant  Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  semestreId  String   @db.Uuid
  semestre    Semestre @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([enseignantId, semestreId])
  @@index([enseignantId])
  @@index([semestreId])
  @@map("decharges")
}

// ============================================
// Salles (L1-10 : types de salle, salles, équipements)
// ============================================

model TypeSalle {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   // ex: "AMPHI", "TD", "TP", "BUREAU"
  libelle   String   // ex: "Amphithéâtre", "Salle de TD", "Bureau"
  estActive Boolean  @default(true)
  originId  String?  // ID d'origine externe (synchronisation)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salles Salle[]

  @@unique([code])
  @@map("types_salle")
}

// ============================================
// Référentiel des sites (L1-14)
// ============================================

model Site {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // ex: "SITE-PRINCIPAL"
  libelle     String   // ex: "Campus Principal"
  estPrincipal Boolean @default(false) // un seul site principal par défaut
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salles Salle[]

  @@index([estPrincipal])
  @@map("sites")
}

model Salle {
  id                   String     @id @default(uuid()) @db.Uuid
  code                 String     // ex: "AMPHI-A"
  libelle              String     // ex: "Amphithéâtre A"
  siteId               String?    @db.Uuid // rattachement à un site (null = non affecté)
  capaciteMax          Int        // capacité maximale (> 0)
  capaciteRecommandee  Int?       // capacité recommandée (<= capaciteMax)
  accesPMR             Boolean    @default(false)
  commentaire          String?
  estActive            Boolean    @default(true)
  departementId        String?    @db.Uuid // null = salle partagée
  typeSalleId          String?    @db.Uuid
  originId             String?    // ID d'origine externe (synchronisation)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  departement Departement? @relation(fields: [departementId], references: [id], onDelete: SetNull)
  typeSalle   TypeSalle?   @relation(fields: [typeSalleId], references: [id], onDelete: SetNull)
  site        Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  equipements SalleEquipement[]
  salleActivityTags SalleActivityTag[] @relation("SalleActivityTag")

  @@index([departementId])
  @@index([typeSalleId])
  @@index([siteId])
  @@map("salles")
}

model Equipement {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   // ex: "VIDEOPROJ", "TABLEAU"
  libelle   String   // ex: "Vidéo projecteur", "Tableau blanc"
  estActive Boolean  @default(true)
  originId  String?  // ID d'origine externe (synchronisation)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salles SalleEquipement[]
  exigencesEquipement ExigenceEquipement[] @relation("EquipementExigenceEquipement")

  @@unique([code])
  @@map("equipements")
}

model SalleEquipement {
  salleId      String @db.Uuid
  equipementId String @db.Uuid
  salle        Salle  @relation(fields: [salleId], references: [id], onDelete: Cascade)
  equipement   Equipement @relation(fields: [equipementId], references: [id], onDelete: Cascade)

  @@id([salleId, equipementId])
  @@map("salles_equipements")
}

// ============================================ 
// Compatibilités salles / Activity Tags (L1-11)
// ============================================

model SalleActivityTag {
  salleId       String   @db.Uuid
  activityTagId String   @db.Uuid

  salle  Salle    @relation("SalleActivityTag", fields: [salleId], references: [id], onDelete: Cascade)
  tag    ActivityTag @relation("ActivityTagSalleActivityTag", fields: [activityTagId], references: [id], onDelete: Cascade)

  @@id([salleId, activityTagId])
  @@map("salle_activity_tags")
}

// ============================================
// Exigences d'équipement par (module, type d'enseignement) (L1-11)
// ============================================

model ExigenceEquipement {
  moduleId           String         @db.Uuid
  typeEnseignementId String         @db.Uuid
  equipementId       String         @db.Uuid
  niveau             ExigenceNiveau @default(OBLIGATOIRE)

  module     Module           @relation("ModuleExigenceEquipement", fields: [moduleId], references: [id], onDelete: Cascade)
  type       TypeEnseignement @relation("TypeExigenceEquipement", fields: [typeEnseignementId], references: [id])
  equipement Equipement       @relation("EquipementExigenceEquipement", fields: [equipementId], references: [id])

  @@id([moduleId, typeEnseignementId, equipementId])
  @@map("exigences_equipement")
}
