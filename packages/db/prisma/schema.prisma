generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum RoleCode {
  ADMINISTRATEUR
  GESTIONNAIRE
  RESPONSABLE_DEPARTEMENT
  ENSEIGNANT
  DIRECTION
  ETUDIANT
}

// Fournisseur d'authentification — L0-14 Interface AuthProvider
// Permet d'authentifier via le fournisseur LOCAL (mot de passe hashé) ou un
// fournisseur externe futur (OIDC, LDAP/AD) sans impacter le RBAC.
enum AuthProvider {
  LOCAL
  OIDC
  LDAP
}

enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  MOVED
}

// Statut d'une année universitaire — L1-02
enum AnneeStatut {
  PREPARATION
  ACTIVE
  CLOTUREE
}

// Statut d'une répartition — L2-06
enum RepartitionStatut {
  BROUILLON
  VALIDEE
  ROUVERTE
}

// Type de demande de modification — L2-15
enum DemandeType {
  ANOMALIE
  MODIFICATION
}

// Statut de demande de modification — L2-15
enum DemandeStatut {
  OUVERTE
  TRAITEE
  REFUSEE
}

// Type de groupe hiérarchique — L1-04
enum GroupeType {
  SECTION
  GROUPE
  SOUS_GROUPE
}

// Niveau d'exigence d'équipement — L1-11
enum ExigenceNiveau {
  OBLIGATOIRE
  SOUHAITE
}

// Jour de la semaine pour la grille horaire — L1-17
enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
}

// Grille d'affichage (normale ou Ramadan) — L1-22
enum GrilleAffichage {
  NORMALE
  RAMADAN
}

enum ContrainteCategorie {
  DURE
  SOUPLE
}

enum ContraintePortee {
  GLOBALE
  ENSEIGNANT
  GROUPE
  SALLE
  MODULE
}

enum ContrainteNature {
  REGLE
  VOEU
}

enum FetSupport {
  NATIF
  PARTIEL
  AUCUN
}

// Classe d'une règle du catalogue — L3-02
enum ClasseRegle {
  HARD_CONSTRAINT
  SOFT_CONSTRAINT
  BUSINESS_VALIDATION
  INFORMATIONAL
}

// Traduction technique d'une règle vers FET — L3-02
enum TraductionFET {
  FET_SUPPORTED
  FET_TRANSFORMED
  APPLICATION_ONLY
}

// Statut d'une génération d'emploi du temps — L4-07
enum GenerationStatut {
  QUEUED
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_WARNINGS
  FAILED
  CANCELLED
  TIMED_OUT
}

// Mode de génération — L4-07
enum GenerationMode {
  AUTOMATIQUE
  MANUELLE
}

// ============================================
// MODELS
// ============================================

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  email              String       @unique
  // Optionnel : un compte authentifié via un fournisseur externe (OIDC/LDAP)
  // n'a pas de mot de passe local.
  passwordHash       String?
  firstName          String       @map("nom")
  lastName           String       @map("prenom")
  isActive           Boolean      @default(true) @map("actif")
  desactiveLe        DateTime?
  failedAttempts     Int          @default(0)
  lockedUntil        DateTime?
  mfaSecret          String?
  mfaActive          Boolean      @default(false)
  mustChangePassword Boolean      @default(false)
  passwordChangedAt  DateTime     @default(now())
  lastLoginAt        DateTime?
  // Fournisseur d'authentification (LOCAL par défaut, OIDC/LDAP pour le SSO futur) — L0-14
  provider           AuthProvider @default(LOCAL)
  // Identifiant sujet du fournisseur externe (ex. sub OIDC), unique par fournisseur — L0-14
  providerSubject    String?      @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  roles                UserSystemRole[]
  assignedTasks        Task[]                @relation("AssignedTasks")
  createdTasks         Task[]                @relation("CreatedTasks")
  comments             Comment[]
  activities           Activity[]
  projectMembers       ProjectMember[]
  sprintMembers        SprintMember[]
  refreshTokens        RefreshToken[]
  passwordHistory      PasswordHistory[]
  resetTokens          PasswordResetToken[]
  demandesModification DemandeModification[]

  @@index([email])
  @@index([isActive])
  @@map("users")
}

model UserSystemRole {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  role            RoleCode
  departementCode String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, departementCode])
  @@map("user_roles")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  familyId       String    @db.Uuid
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastActivityAt DateTime  @default(now())
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  demandePar String    @db.Uuid
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  key         String        @unique
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members ProjectMember[]
  tasks   Task[]
  sprints Sprint[]
  columns BoardColumn[]

  @@index([key])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  role      UserRole @default(VIEWER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model BoardColumn {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  position  Int
  color     String   @default("#6366f1")
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([position])
  @@map("board_columns")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  columnId    String?      @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  storyPoints Int?
  position    Int          @default(0)
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column       BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId   String?      @db.Uuid
  creator      User         @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId    String       @db.Uuid
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  sprintId     String?      @db.Uuid
  parentTask   Task?        @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  parentTaskId String?      @db.Uuid
  subtasks     Task[]       @relation("Subtasks")
  comments     Comment[]
  activities   Activity[]
  tags         TaskTag[]

  @@index([projectId])
  @@index([columnId])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([status])
  @@index([parentTaskId])
  @@map("tasks")
}

model Sprint {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  name      String
  goal      String?
  status    SprintStatus @default(PLANNING)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  members SprintMember[]

  @@index([projectId])
  @@index([status])
  @@map("sprints")
}

model SprintMember {
  id       String @id @default(uuid()) @db.Uuid
  sprintId String @db.Uuid
  userId   String @db.Uuid

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sprintId, userId])
  @@index([sprintId])
  @@index([userId])
  @@map("sprint_members")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @db.Uuid
  tagId  String @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  taskId    String?      @db.Uuid
  userId    String       @db.Uuid
  type      ActivityType
  field     String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime     @default(now())

  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

// Paramètres de sécurité (ligne unique, CHECK id = 1) — EX-SEC-04
model ParametreSecurite {
  id                        Int        @id @default(1)
  longueurMin               Int        @default(12)
  regles                    Json       @default("{}")
  expirationJours           Int        @default(0)
  historique                Int        @default(5)
  maxEchecs                 Int        @default(5)
  verrouillageMinutes       Int        @default(15)
  inactiviteMinutes         Int        @default(30)
  mfaRoles                  RoleCode[] @default([ADMINISTRATEUR])
  conservationAuditJours    Int?
  conservationSecuriteJours Int        @default(365)
  updatedAt                 DateTime   @updatedAt
  updatedBy                 String?    @db.Uuid

  @@map("parametres_securite")
}

// Circuit de validation et de publication (ligne unique, CHECK id = 1) — EX-WFL-02
model ParametreWorkflow {
  id                        Int      @id @default(1)
  validationPlanningRequise Boolean  @default(true)
  publicationRequise        Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  updatedBy                 String?  @db.Uuid

  @@map("parametres_workflow")
}

// Journal de sécurité, séparé de l'audit métier — EX-SEC-09
model SecurityEvent {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now())
  type      String
  userId    String?  @db.Uuid
  email     String?
  ip        String?
  userAgent String?
  requestId String?
  details   Json?

  @@index([type, at])
  @@index([userId, at])
  @@map("security_events")
}

// Audit append-only — EX-AUD-01
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  at             DateTime @default(now())
  userId         String?  @db.Uuid
  action         String
  objetType      String
  objetId        String
  ancienneValeur Json?
  nouvelleValeur Json?
  versionId      String?  @db.Uuid
  motif          String?
  requestId      String?
  ip             String?

  @@index([objetType, objetId])
  @@index([versionId, at])
  @@index([userId, at])
  @@map("audit_logs")
}

// ============================================
// Calendrier scolaire (L1-01 : années & semestres)
// ============================================

model Annee {
  id         String      @id @default(uuid()) @db.Uuid
  numero     Int // ex: 2026
  code       String // ex: "2026-2027"
  nbSemaines Int         @default(14)
  statut     AnneeStatut @default(PREPARATION)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  semestres      Semestre[]
  departements   Departement[]
  enseignants    Enseignant[]
  chargeRuleSets ChargeRuleSet[]

  @@unique([code])
  @@unique([numero])
  @@map("annees")
}

model Semestre {
  id           String   @id @default(uuid()) @db.Uuid
  numero       Int // 1 ou 2
  anneeId      String   @db.Uuid
  annee        Annee    @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  nbSemaines   Int      @default(14)
  grilleParams Json? // {jours:[{jour, debut, fin, pauses:[{debut, fin}]}]} pour regenerer la grille
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groupes              Groupe[]
  decharges            Decharge[]
  creneaux             Creneau[]
  indisponibilites     Indisponibilite[]
  contrainteInstances  ContrainteInstance[]
  repartitions         Repartition[]
  demandesModification DemandeModification[]
  seances              Seance[]
  versions             VersionEdt[]
  groupesCovoiturage   GroupeCovoiturage[]
  exigencesSalle       ExigenceSalleActivite[]
  generations          Generation[]

  @@unique([anneeId, numero])
  @@map("semestres")
}

// ============================================
// Grille horaire (L1-17 : créneaux et pauses)
// ============================================

model Creneau {
  id         String      @id @default(uuid()) @db.Uuid
  semestreId String      @db.Uuid
  semestre   Semestre    @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  jour       JourSemaine
  ordre      Int // position dans la journée (1..n)
  heureDebut DateTime    @db.Time
  heureFin   DateTime    @db.Time
  estPause   Boolean     @default(false)
  estActive  Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  affichages CreneauAffichage[]
  seances    Seance[]

  @@unique([semestreId, jour, ordre])
  @@index([semestreId, jour])
  @@map("creneaux")
}

// ============================================
// Correspondance d'affichage Ramadan (L1-22 : EX-CAL-04)
// La grille NORMALE est dérivée de Creneau ; RAMADAN associe un horaire d'affichage libre par créneau.
// ============================================

model CreneauAffichage {
  id         String          @id @default(uuid()) @db.Uuid
  creneauId  String          @db.Uuid
  grille     GrilleAffichage @default(RAMADAN)
  heureDebut DateTime        @db.Time(0)
  heureFin   DateTime        @db.Time(0) // durée libre, pas de contrainte de 30 minutes

  creneau Creneau @relation(fields: [creneauId], references: [id], onDelete: Cascade)

  @@unique([creneauId, grille])
  @@index([creneauId])
  @@map("creneau_affichage")
}

// ============================================
// Séances placées (L3-08 : contrôle fenêtre de pause)
// Une séance est l'affectation d'un créneau à un enseignant (et un ou plusieurs groupes)
// pour un jour donné, dans un semestre.
// ============================================
model Seance {
  id           String      @id @default(uuid()) @db.Uuid
  semestreId   String      @db.Uuid
  semestre     Semestre    @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  versionId    String?     @db.Uuid
  version      VersionEdt? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  enseignantId String?     @db.Uuid
  enseignant   Enseignant? @relation(fields: [enseignantId], references: [id], onDelete: SetNull)
  salleId      String?     @db.Uuid
  salle        Salle?      @relation(fields: [salleId], references: [id], onDelete: SetNull)
  affectationKey String   // `${groupeId}:${moduleId}:${typeEnseignementId}:${enseignantId}`
  rang         Int         @default(1) // index de la séance dans l'affectation
  tag          String?     // tag résolu du snapshot
  jour         JourSemaine? // renseigné lors du placement (L3-10)
  creneauDebutId String?   @db.Uuid // renseigné lors du placement (L3-10)
  creneauDebut Creneau?    @relation(fields: [creneauDebutId], references: [id], onDelete: SetNull)
  nbCreneaux   Int         @default(1)
  statut       SeanceStatut @default(NON_PLACEE) // PLACEE | NON_PLACEE
  origine      SeanceOrigine @default(MOTEUR)
  revision     Int         @default(0)
  groupes      SeanceGroupe[]
  occupations  Occupation[]
  verrous      VerrouSeance[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([semestreId])
  @@index([enseignantId])
  @@index([salleId])
  @@index([versionId])
  @@index([versionId, jour, creneauDebutId])
  @@index([versionId, enseignantId])
  @@index([versionId, salleId])
  @@unique([versionId, affectationKey, rang])
  @@map("seances")
}

model SeanceGroupe {
  seanceId   String @db.Uuid
  groupeId   String @db.Uuid
  seance     Seance @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  groupe     Groupe @relation(fields: [groupeId], references: [id], onDelete: Cascade)

  @@id([seanceId, groupeId])
  @@index([groupeId])
  @@map("seance_groupes")
}

// ============================================
// Occupations de ressources (L3-10)
// Une ligne par créneau couvert et par ressource occupée (enseignant, salle, groupe).
// Garantit l'unicité d'une ressource sur un créneau donné dans une version.
// ============================================
model Occupation {
  id            String        @id @default(uuid()) @db.Uuid
  versionId     String        @db.Uuid
  seanceId      String        @db.Uuid
  jour          JourSemaine
  creneauId     String        @db.Uuid
  ressourceType RessourceType
  ressourceId   String        @db.Uuid

  version VersionEdt @relation(fields: [versionId], references: [id], onDelete: Cascade)
  seance  Seance     @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  @@unique([versionId, jour, creneauId, ressourceType, ressourceId])
  @@index([seanceId])
  @@map("occupations")
}

// ============================================
// Versions & séances (L3-09 : création de version)
// Une version de travail porte un numéro (majeur.mineur), un statut et
// référence les snapshots de répartition qui la composent.
// ============================================

enum VersionStatut {
  BROUILLON
  EDITION
  EN_VALIDATION
  VALIDE
  PUBLIE
  ARCHIVE
  CORRECTION
}

enum SeanceStatut {
  PLACEE
  NON_PLACEE
}

enum SeanceOrigine {
  MOTEUR
  MANUEL
}

enum RessourceType {
  ENSEIGNANT
  SALLE
  GROUPE
}

model VersionEdt {
  id          String        @id @default(uuid()) @db.Uuid
  semestreId  String        @db.Uuid
  semestre    Semestre      @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  numero      String        // ex. "1.0", "2.0"
  statut      VersionStatut @default(BROUILLON)
  motif       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seances                         Seance[]
  occupations                     Occupation[]
  snapshots                       VersionSnapshot[]
  conflits                        Conflit[]
  editLock                        EditLock?
  verrous                         VerrouSeance[]
  avertissementsAcceptes          AvertissementAccepte[]
  generations                     Generation[]

  @@index([semestreId])
  @@index([statut])
  @@map("versions_edt")
}

model VersionSnapshot {
  versionId  String @db.Uuid
  snapshotId String @db.Uuid
  version    VersionEdt @relation(fields: [versionId], references: [id], onDelete: Cascade)
  snapshot   Snapshot   @relation(fields: [snapshotId], references: [id])

  @@id([versionId, snapshotId])
  @@map("version_snapshots")
}

model EditLock {
  id        String   @id @default(uuid()) @db.Uuid
  versionId String   @unique @db.Uuid
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  version VersionEdt @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("edit_locks")
}

// Type de verrou sur une séance (EX-VRR-01, L3-36).
enum VerrouType {
  CRENEAU
  SALLE
  ENSEIGNANT
  ACTIVITE
}

// Verrous par séance (EX-VRR-01). Un verrou levé reste en base (historique).
// Un seul verrou actif par (séance, type) — index partiel sur leveLe IS NULL.
model VerrouSeance {
  id            String     @id @default(uuid()) @db.Uuid
  versionId     String     @db.Uuid
  seanceId      String     @db.Uuid
  type          VerrouType
  auteurId      String     @db.Uuid
  justification String?
  creeLe        DateTime   @default(now())
  leveLe        DateTime?
  levePar       String?    @db.Uuid

  version VersionEdt @relation(fields: [versionId], references: [id], onDelete: Cascade)
  seance  Seance     @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  @@index([versionId, leveLe])
  @@index([seanceId])
  @@map("verrous_seances")
}

// ============================================
// Structure académique (L1-03 : départements, formations, niveaux)
// ============================================

model Departement {
  id        String   @id @default(uuid()) @db.Uuid
  anneeId   String   @db.Uuid
  annee     Annee    @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  code      String // ex: "INFO", "MATH"
  libelle   String // ex: "Informatique", "Mathématiques"
  ordre     Int      @default(0)
  originId  String? // ID d'origine externe (synchronisation)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formations   Formation[]
  enseignants  Enseignant[]
  salles       Salle[]
  repartitions Repartition[]

  @@unique([anneeId, code])
  @@index([anneeId, ordre])
  @@map("departements")
}

model Formation {
  id            String      @id @default(uuid()) @db.Uuid
  departementId String      @db.Uuid
  departement   Departement @relation(fields: [departementId], references: [id], onDelete: Cascade)
  code          String // ex: "L3-INFO"
  libelle       String // ex: "Licence 3 Informatique"
  ordre         Int         @default(0)
  originId      String? // ID d'origine externe (synchronisation)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  niveaux Niveau[]

  @@unique([departementId, code])
  @@index([departementId, ordre])
  @@map("formations")
}

model Niveau {
  id          String    @id @default(uuid()) @db.Uuid
  formationId String    @db.Uuid
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  code        String // ex: "L3"
  libelle     String // ex: "Licence 3"
  ordre       Int       @default(0)
  originId    String? // ID d'origine externe (synchronisation)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  groupes Groupe[]
  modules Module[]

  @@unique([formationId, code])
  @@index([formationId, ordre])
  @@map("niveaux")
}

// ============================================
// Groupes hiérarchiques (L1-04)
// ============================================

model Groupe {
  id           String        @id @default(uuid()) @db.Uuid
  niveauId     String        @db.Uuid
  niveau       Niveau        @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  semestreId   String        @db.Uuid
  semestre     Semestre      @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  parentId     String?       @db.Uuid
  parent       Groupe?       @relation("GroupesHierarchie", fields: [parentId], references: [id])
  enfants      Groupe[]      @relation("GroupesHierarchie")
  type         GroupeType
  code         String // ex: "INFO-L3-S1"
  libelle      String // ex: "L3 Informatique Semestre 1"
  ordre        Int           @default(0)
  effectif     Int           @default(0)
  originId     String? // ID d'origine externe (synchronisation)
  affectations Affectation[]
  seanceGroupes SeanceGroupe[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([niveauId, semestreId, code])
  @@index([niveauId, semestreId, ordre])
  @@index([semestreId])
  @@index([parentId])
  @@map("groupes")
}

// ============================================
// Modules, types d'enseignement et grades (L1-05)
// ============================================

enum TypeEnseignementCode {
  CM
  TD
  TP
  CI
  AUTRE
}

model TypeEnseignement {
  id            String               @id @default(uuid()) @db.Uuid
  code          TypeEnseignementCode
  libelle       String
  activityTagId String?              @db.Uuid
  activityTag   ActivityTag?         @relation(fields: [activityTagId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  modules             Module[]
  exigencesEquipement ExigenceEquipement[] @relation("TypeExigenceEquipement")
  chargeCoefficients  ChargeCoefficient[]
  affectations        Affectation[]

  @@unique([code])
  @@map("types_enseignement")
}

enum GradeCode {
  MC
  MCF
  PR
  ATER
  AUTRE
}

model Grade {
  id        String    @id @default(uuid()) @db.Uuid
  code      GradeCode
  libelle   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  modules               Module[]
  enseignants           Enseignant[]
  chargeReferenceGrades ChargeReferenceGrade[]

  @@unique([code])
  @@map("grades")
}

model Module {
  id                  String               @id @default(uuid()) @db.Uuid
  niveauId            String               @db.Uuid
  niveau              Niveau               @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  typeId              String               @db.Uuid
  type                TypeEnseignement     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  gradeId             String?              @db.Uuid
  grade               Grade?               @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  code                String // ex: "INFO301"
  libelle             String // ex: "Algorithmique avancée"
  semestreNumero      Int // 1 ou 2
  credits             Int?                 @default(6)
  effectifMax         Int? // capacité max du module
  originId            String? // ID d'origine externe (synchronisation)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  enseignantModules   EnseignantModule[]
  exigencesEquipement ExigenceEquipement[] @relation("ModuleExigenceEquipement")
  moduleVolumes       ModuleVolume[]
  affectations        Affectation[]

  @@unique([niveauId, code, semestreNumero])
  @@index([niveauId])
  @@index([typeId])
  @@index([gradeId])
  @@map("modules")
}

// ============================================
// Module Volumes (L2-01)
// ============================================

model ModuleVolume {
  id        String   @id @default(uuid()) @db.Uuid
  moduleId  String   @db.Uuid
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type      String // CM, TD, TP, CI, AUTRE
  volume    Int // en minutes, multiple de 30
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, type])
  @@index([moduleId])
  @@map("module_volumes")
}

// ============================================
// Jeux de règles de charge (L2-03)
// ============================================

enum PeriodeRegle {
  HEBDOMADAIRE
  SEMESTRIELLE
  ANNUELLE
}

model ChargeRuleSet {
  id        String       @id @default(uuid()) @db.Uuid
  numero    Int
  periode   PeriodeRegle
  seuil     Int?
  plafond   Int?
  arrondi   Int?
  publieLe  DateTime?
  anneeId   String?      @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  annee           Annee?                 @relation(fields: [anneeId], references: [id], onDelete: SetNull)
  referenceGrades ChargeReferenceGrade[]
  coefficients    ChargeCoefficient[]

  @@unique([numero])
  @@index([periode])
  @@index([anneeId])
  @@map("charge_rule_sets")
}

model ChargeReferenceGrade {
  id          String   @id @default(uuid()) @db.Uuid
  rulesetId   String   @map("ruleSetId") @db.Uuid
  gradeId     String?  @db.Uuid
  coefficient Decimal  @db.Decimal
  createdAt   DateTime @default(now())

  ruleset ChargeRuleSet @relation(fields: [rulesetId], references: [id], onDelete: Cascade)
  grade   Grade?        @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  @@unique([rulesetId, gradeId])
  @@index([rulesetId])
  @@index([gradeId])
  @@map("charge_reference_grades")
}

model ChargeCoefficient {
  id          String   @id @default(uuid()) @db.Uuid
  rulesetId   String   @map("ruleSetId") @db.Uuid
  typeId      String   @db.Uuid
  coefficient Decimal  @db.Decimal
  createdAt   DateTime @default(now())

  ruleset ChargeRuleSet    @relation(fields: [rulesetId], references: [id], onDelete: Cascade)
  type    TypeEnseignement @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([rulesetId, typeId])
  @@index([rulesetId])
  @@index([typeId])
  @@map("charge_coefficients")
}

// ============================================
// Activity Tags (L1-06)
// ============================================

model ActivityTag {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  libelle   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  typesEnseignement TypeEnseignement[]
  salleActivityTags SalleActivityTag[] @relation("ActivityTagSalleActivityTag")
  affectations      Affectation[]

  @@index([code])
  @@index([isActive])
  @@map("activity_tags")
}

model Enseignant {
  id                String             @id @default(uuid()) @db.Uuid
  matricule         String
  nom               String
  prenom            String
  email             String             @unique
  telephone         String?
  isActive          Boolean            @default(true)
  anneeId           String             @db.Uuid
  annee             Annee              @relation(fields: [anneeId], references: [id], onDelete: Cascade)
  departementId     String             @db.Uuid
  departement       Departement        @relation(fields: [departementId], references: [id], onDelete: Cascade)
  gradeId           String?            @db.Uuid
  grade             Grade?             @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  originId          String? // ID d'origine externe (synchronisation)
  enseignantModules EnseignantModule[]
  decharges         Decharge[]
  indisponibilites  Indisponibilite[]
  affectations      Affectation[]
  seances           Seance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([anneeId, matricule])
  @@index([departementId])
  @@index([gradeId])
  @@index([email])
  @@map("enseignants")
}

model EnseignantModule {
  enseignantId String     @db.Uuid
  moduleId     String     @db.Uuid
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([enseignantId, moduleId])
  @@map("enseignant_modules")
}

// ============================================
// Décharges enseignant (L1-08)
// ============================================

model Decharge {
  id           String     @id @default(uuid()) @db.Uuid
  heures       Float // heures équivalentes de décharge
  enseignantId String     @db.Uuid
  enseignant   Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  semestreId   String     @db.Uuid
  semestre     Semestre   @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([enseignantId, semestreId])
  @@index([enseignantId])
  @@index([semestreId])
  @@map("decharges")
}

// ============================================
// Salles (L1-10 : types de salle, salles, équipements)
// ============================================

model TypeSalle {
  id        String   @id @default(uuid()) @db.Uuid
  code      String // ex: "AMPHI", "TD", "TP", "BUREAU"
  libelle   String // ex: "Amphithéâtre", "Salle de TD", "Bureau"
  estActive Boolean  @default(true)
  originId  String? // ID d'origine externe (synchronisation)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salles Salle[]

  @@unique([code])
  @@map("types_salle")
}

// ============================================
// Référentiel des sites (L1-14)
// ============================================

model Site {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique // ex: "SITE-PRINCIPAL"
  libelle      String // ex: "Campus Principal"
  estPrincipal Boolean  @default(false) // un seul site principal par défaut
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salles Salle[]

  @@index([estPrincipal])
  @@map("sites")
}

model Salle {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String // ex: "AMPHI-A"
  libelle             String // ex: "Amphithéâtre A"
  siteId              String?  @db.Uuid // rattachement à un site (null = non affecté)
  capaciteMax         Int // capacité maximale (> 0)
  capaciteRecommandee Int? // capacité recommandée (<= capaciteMax)
  accesPMR            Boolean  @default(false)
  commentaire         String?
  estActive           Boolean  @default(true)
  departementId       String?  @db.Uuid // null = salle partagée
  typeSalleId         String?  @db.Uuid
  originId            String? // ID d'origine externe (synchronisation)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  departement       Departement?       @relation(fields: [departementId], references: [id], onDelete: SetNull)
  typeSalle         TypeSalle?         @relation(fields: [typeSalleId], references: [id], onDelete: SetNull)
  site              Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  equipements       SalleEquipement[]
  salleActivityTags SalleActivityTag[] @relation("SalleActivityTag")
  indisponibilites  Indisponibilite[]
  seances           Seance[]
  exigencesSalleImposee ExigenceSalleActivite[]
  exigencesSalleAutorisee ExigenceSalleAutorisee[]

  @@index([departementId])
  @@index([typeSalleId])
  @@index([siteId])
  @@map("salles")
}

// ============================================
// Indisponibilités (L1-20 : enseignants et salles)
// ============================================

model Indisponibilite {
  id           String      @id @default(uuid()) @db.Uuid
  semestreId   String      @db.Uuid
  semestre     Semestre    @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  jour         JourSemaine
  ordre        Int // position dans la journée (1..n)
  enseignantId String?     @db.Uuid
  enseignant   Enseignant? @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  salleId      String?     @db.Uuid
  salle        Salle?      @relation(fields: [salleId], references: [id], onDelete: Cascade)
  estActive    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([semestreId, jour, ordre, enseignantId, salleId])
  @@index([semestreId, jour, ordre])
  @@index([enseignantId])
  @@index([salleId])
  @@map("indisponibilites")
}

model Equipement {
  id        String   @id @default(uuid()) @db.Uuid
  code      String // ex: "VIDEOPROJ", "TABLEAU"
  libelle   String // ex: "Vidéo projecteur", "Tableau blanc"
  estActive Boolean  @default(true)
  originId  String? // ID d'origine externe (synchronisation)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salles              SalleEquipement[]
  exigencesEquipement ExigenceEquipement[] @relation("EquipementExigenceEquipement")

  @@unique([code])
  @@map("equipements")
}

model SalleEquipement {
  salleId      String     @db.Uuid
  equipementId String     @db.Uuid
  salle        Salle      @relation(fields: [salleId], references: [id], onDelete: Cascade)
  equipement   Equipement @relation(fields: [equipementId], references: [id], onDelete: Cascade)

  @@id([salleId, equipementId])
  @@map("salles_equipements")
}

// ============================================ 
// Compatibilités salles / Activity Tags (L1-11)
// ============================================

model SalleActivityTag {
  salleId       String @db.Uuid
  activityTagId String @db.Uuid

  salle Salle       @relation("SalleActivityTag", fields: [salleId], references: [id], onDelete: Cascade)
  tag   ActivityTag @relation("ActivityTagSalleActivityTag", fields: [activityTagId], references: [id], onDelete: Cascade)

  @@id([salleId, activityTagId])
  @@map("salle_activity_tags")
}

// ============================================
// Exigences d'équipement par (module, type d'enseignement) (L1-11)
// ============================================

model ExigenceEquipement {
  moduleId           String         @db.Uuid
  typeEnseignementId String         @db.Uuid
  equipementId       String         @db.Uuid
  niveau             ExigenceNiveau @default(OBLIGATOIRE)

  module     Module           @relation("ModuleExigenceEquipement", fields: [moduleId], references: [id], onDelete: Cascade)
  type       TypeEnseignement @relation("TypeExigenceEquipement", fields: [typeEnseignementId], references: [id])
  equipement Equipement       @relation("EquipementExigenceEquipement", fields: [equipementId], references: [id])

  @@id([moduleId, typeEnseignementId, equipementId])
  @@map("exigences_equipement")
}

// ============================================
// Contraintes - L3-01
// ============================================

model ContrainteDefinition {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @unique
  libelle       String
  categorie     ContrainteCategorie
  portee        ContraintePortee
  classe        ClasseRegle         @default(HARD_CONSTRAINT)
  traductionFET TraductionFET       @default(FET_SUPPORTED)
  paramsSchema  Json
  fetSupport    FetSupport          @default(NATIF)
  actif         Boolean             @default(true)

  instances ContrainteInstance[]

  @@map("contrainte_definitions")
}

model ContrainteInstance {
  id           String           @id @default(uuid()) @db.Uuid
  semestreId   String           @db.Uuid
  definitionId String           @db.Uuid
  enseignantId String?          @db.Uuid
  groupeId     String?          @db.Uuid
  salleId      String?          @db.Uuid
  moduleId     String?          @db.Uuid
  originId     String?          // ID de l'instance source en cas de duplication
  params       Json
  poids        Int?
  nature       ContrainteNature @default(REGLE)
  commentaire  String?
  actif        Boolean          @default(true)
  creePar      String           @db.Uuid
  creeLe       DateTime         @default(now())

  semestre   Semestre             @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  definition ContrainteDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([semestreId, actif])
  // Unicité : une instance de même définition ne peut cibler qu'un seul sujet par semestre.
  // Les index partiels (migration SQL brute) gèrent le cas des NULL (globales) proprement sous PostgreSQL.
  @@unique([semestreId, definitionId, enseignantId, groupeId, salleId, moduleId])
  @@map("contrainte_instances")
}

// ============================================
// Répartitions (L2-06 : répartitions par département et semestre)
// Une répartition lie un (semestre, département) avec un statut BROUILLON / VALIDEE / ROUVERTE.
// ============================================

model Repartition {
  id            String            @id @default(uuid()) @db.Uuid
  semestreId    String            @db.Uuid
  departementId String            @db.Uuid
  statut        RepartitionStatut @default(BROUILLON)
  libelle       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  semestre     Semestre      @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  departement  Departement   @relation(fields: [departementId], references: [id], onDelete: Cascade)
  affectations Affectation[]

  @@unique([semestreId, departementId])
  @@index([semestreId])
  @@index([departementId])
  @@map("repartitions")
}

// ============================================
// Affectations d'enseignants aux cours/groupes (L2-07)
// Une affectation lie un enseignant, un module, un type d'enseignement,
// un groupe optionnel et une activité tag optionnel à une répartition.
// Le volumeHebdoMinutes est calculé par le serveur (seancesParSemaine * dureeMinutes).
// ============================================

model Affectation {
  id                 String   @id @default(uuid()) @db.Uuid
  repartitionId      String   @db.Uuid
  enseignantId       String   @db.Uuid
  groupeId           String?  @db.Uuid
  moduleId           String   @db.Uuid
  typeEnseignementId String   @db.Uuid
  activityTagId      String?  @db.Uuid
  volumeHebdoMinutes Int // calculé par le serveur : seancesParSemaine * dureeMinutes
  seancesParSemaine  Int // >= 1
  dureeMinutes       Int // multiple de 30
  estCmCommun        Boolean  @default(false)
  workingRevision    Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  repartition      Repartition      @relation(fields: [repartitionId], references: [id], onDelete: Cascade)
  enseignant       Enseignant       @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  groupe           Groupe?          @relation(fields: [groupeId], references: [id], onDelete: SetNull)
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  typeEnseignement TypeEnseignement @relation(fields: [typeEnseignementId], references: [id], onDelete: Cascade)
  activityTag      ActivityTag?     @relation(fields: [activityTagId], references: [id], onDelete: SetNull)

  @@unique([repartitionId, enseignantId, moduleId, typeEnseignementId, groupeId])
  @@index([repartitionId])
  @@index([enseignantId])
  @@index([moduleId])
  @@index([typeEnseignementId])
  @@index([groupeId])
  @@map("affectations")
}

// ============================================
// Snapshots de validation (L2-12)
// Un snapshot fige l'état d'une répartition validée
// pour garantir l'immuabilité (ST §4.1.2).
// ============================================

model Snapshot {
  id                String            @id @default(uuid()) @db.Uuid
  repartitionId     String            @db.Uuid
  tag               String // tag résolu (ex. numéro de version)
  hash              String // hash de l'état figé
  valideParId       String            @db.Uuid // userId du validateur
  valideLe          DateTime          @default(now())
  parAdministrateur Boolean           @default(false) // true si validé par un Administrateur
  repartitionStatut RepartitionStatut
  createdAt         DateTime          @default(now())

  versionSnapshots  VersionSnapshot[]

  @@index([repartitionId])
  @@map("snapshots")
}

model SnapshotAffectation {
  id                 String  @id @default(uuid()) @db.Uuid
  snapshotId         String  @db.Uuid
  enseignantId       String  @db.Uuid
  groupeId           String? @db.Uuid
  moduleId           String  @db.Uuid
  typeEnseignementId String  @db.Uuid
  activityTagId      String? @db.Uuid
  volumeHebdoMinutes Int
  seancesParSemaine  Int
  dureeMinutes       Int
  estCmCommun        Boolean
  workingRevision    Int

  @@index([snapshotId])
  @@map("snapshot_affectations")
}

model SnapshotCharge {
  id              String   @id @default(uuid()) @db.Uuid
  snapshotId      String   @db.Uuid
  enseignantId    String   @db.Uuid
  volumeBrut      Int // volume brut en minutes
  chargeCalculee  Int // charge calculée en minutes
  chargeReference Int // charge de référence en minutes
  decharges       Int // décharges en minutes
  serviceDu       Int // service dû en minutes
  ecart           Int // écart en minutes
  heuresSup       Int // heures supplémentaires en minutes
  createdAt       DateTime @default(now())

  @@index([snapshotId])
  @@map("snapshot_charges")
}

// ============================================
// Demandes de modification (L2-15)
// Une demande signale une anomalie ou demande une modification
// de répartition, liée à un semestre et à un département.
// ============================================

model DemandeModification {
  id              String        @id @default(uuid()) @db.Uuid
  semestreId      String        @db.Uuid
  departementCode String
  auteurId        String        @db.Uuid
  versionId       String?       @db.Uuid
  type            DemandeType
  cible           Json
  motif           String
  statut          DemandeStatut @default(OUVERTE)
  reponse         String?
  traiteePar      String?       @db.Uuid
  createdAt       DateTime      @default(now())
  traiteeLe       DateTime?

  semestre Semestre @relation(fields: [semestreId], references: [id])
  auteur   User     @relation(fields: [auteurId], references: [id])

  @@index([departementCode, statut])
  @@map("demandes_modification")
}

// ============================================
// Conflits (L3-17 : recalcul complet et incrémental)
// Un conflit relie une règle détectée par le conflict-engine à une ou plusieurs séances
// d'une version. résoluLe est renseigné quand le conflit n'est plus présent lors d'un recalcul.
// ============================================

enum ConflitType {
  ENSEIGNANT
  SALLE
  GROUPE
  CAPACITE
  DISPONIBILITE
  COMPATIBILITE
  PEDAGOGIQUE
  COMPLETUDE
  VERROU
  COVOITURAGE
  VOEU
}

enum ConflitSeverite {
  BLOQUANT
  AVERTISSEMENT
  INFORMATION
}

model Conflit {
  id          String        @id @default(uuid()) @db.Uuid
  versionId   String        @db.Uuid
  regleCode   String
  type        ConflitType
  severite    ConflitSeverite
  objetType   String
  objetId     String
  seanceIds   String[]      // IDs des séances impliquées (tableau PostgreSQL text[])
  message     String
  signature   String        // empreinte stable du conflit (computeSignature)
  details     Json?         // contexte supplémentaire (slotKeys, volumes, etc.)
  resoluLe    DateTime?     // renseigné quand le conflit disparaît lors d'un recalcul
  createdAt   DateTime      @default(now())

  version VersionEdt @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, resoluLe])
  @@index([versionId, type])
  @@index([versionId, signature])
  @@map("conflits")
}

// Acceptation d'un avertissement (EX-CTR-07), liée à la signature du conflit.
// ST §4.15 : traçage utilisateur, date, règle, version, caducité par signature.
model AvertissementAccepte {
  id              String    @id @default(uuid()) @db.Uuid
  versionId       String    @db.Uuid
  regleCode       String
  signature       String
  seanceIds       String[]  @db.Uuid
  auteurId        String    @db.Uuid
  justification   String?
  versionRevision Int
  acceptePar      String    @db.Uuid
  accepteLe       DateTime  @default(now())
  caduqueLe       DateTime? // renseigné quand la signature disparaît ou change

  version VersionEdt @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, signature])
  @@map("avertissements_acceptes")
}

// ============================================
// Groupes de covoiturage (L3-41)
// Un groupe de covoiturage lie plusieurs enseignants d'un même semestre,
// avec une marge de tolérance (minutes) entre leurs créneaux, un nombre
// minimum de jours communs et une option strict (conflit bloquant si violé).
// ============================================

model GroupeCovoiturage {
  id            String   @id @default(uuid()) @db.Uuid
  semestreId    String   @db.Uuid
  margeMinutes  Int      @default(60)
  joursCommunsMin Int    @default(1)
  strict        Boolean  @default(false)
  enseignantIds String[] @db.Uuid
  createdAt     DateTime @default(now())

  semestre Semestre @relation(fields: [semestreId], references: [id], onDelete: Cascade)

  @@index([semestreId])
  @@map("groupes_covoiturage")
}

// ============================================
// Exigences de salle par activité (L3-43)
// Une exigence porte une salle imposée et/ou une liste de salles autorisées,
// par semestre et affectationKey (groupe:module:type:enseignant).
// Écriture réservée au Gestionnaire et à l'Administrateur.
// ============================================

model ExigenceSalleActivite {
  id             String   @id @default(uuid()) @db.Uuid
  semestreId     String   @db.Uuid
  affectationKey String
  salleImposeeId String?  @db.Uuid
  creePar        String   @db.Uuid
  creeLe         DateTime @default(now())
  updatedAt      DateTime @updatedAt

  semestre     Semestre                  @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  salleImposee Salle?                    @relation(fields: [salleImposeeId], references: [id])
  autorisees   ExigenceSalleAutorisee[]

  @@unique([semestreId, affectationKey])
  @@index([semestreId])
  @@index([salleImposeeId])
  @@map("exigences_salle_activite")
}

model ExigenceSalleAutorisee {
  exigenceId String @db.Uuid
  salleId    String @db.Uuid

  exigence ExigenceSalleActivite @relation(fields: [exigenceId], references: [id], onDelete: Cascade)
  salle    Salle                 @relation(fields: [salleId], references: [id])

  @@id([exigenceId, salleId])
  @@index([salleId])
  @@map("exigences_salle_autorisee")
}

// ============================================
// Génération d'emploi du temps — L4-07
// ============================================

model Generation {
  id            String           @id @default(uuid()) @db.Uuid
  semestreId    String           @db.Uuid
  versionId     String           @db.Uuid
  auteurId      String           @db.Uuid
  statut        GenerationStatut @default(QUEUED)
  mode          GenerationMode   @default(AUTOMATIQUE)
  engine        String           @default("fet")
  engineVersion String?
  erreur        String?
  metrics       Json?
  score         Decimal?         @db.Decimal(5, 2)
  cancelRequested Boolean      @default(false)
  queuedAt      DateTime         @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  semestre Semestre @relation(fields: [semestreId], references: [id], onDelete: Cascade)
  version  VersionEdt @relation(fields: [versionId], references: [id], onDelete: Cascade)
  seances  GenerationSeance[] @relation("generation_seances_generation")

  @@index([semestreId, statut])
  @@map("generations")
}

// Résultat brut de génération (séquences placées / non placées)
// Référence ST §4.6.5 — appariement par affectationKey#rang
model GenerationSeance {
  id                 String       @id @default(uuid()) @db.Uuid
  generationId       String       @db.Uuid
  affectationKey     String
  rang               Int
  groupeIds          String[]     @db.Uuid
  moduleId           String       @db.Uuid
  typeEnseignementId String       @db.Uuid
  activityTagId      String       @db.Uuid
  enseignantId       String       @db.Uuid
  salleId            String?      @db.Uuid
  jour               String?
  creneauDebutId     String?      @db.Uuid
  nbCreneaux         Int
  statut             SeanceStatut
  @@unique([generationId, affectationKey, rang])

  generation Generation @relation("generation_seances_generation", fields: [generationId], references: [id], onDelete: Cascade)
  @@index([generationId, statut])
  @@map("generation_seances")
}
