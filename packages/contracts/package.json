{
  "name": "@takt/contracts",
  "version": "0.0.1",
  "description": "TAKT Contracts - Zod schemas and OpenAPI types",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./zod/*": {
      "types": "./dist/zod/*.d.ts",
      "import": "./dist/zod/*.mjs",
      "require": "./dist/zod/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi-types.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.4.0",
    "oxlint": "^1.58.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2"
  }
}
